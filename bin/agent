#!/usr/bin/env bash
set -euo pipefail

KNOWN_TOOLS="codex claude opencode codemachine omp commandcode"
NIX_FEATURES="${AGENT_NIX_EXPERIMENTAL_FEATURES:-nix-command flakes}"
PERF_LOG="${AGENT_PERF_LOG:-1}"

now_ms() {
  local ts
  ts="$(date +%s%3N 2>/dev/null || true)"
  case "$ts" in
    *N*|"")
      echo "$(( $(date +%s) * 1000 ))"
      ;;
    *)
      echo "$ts"
      ;;
  esac
}

format_duration_ms() {
  local ms="$1"
  if [ "$ms" -ge 1000 ]; then
    printf '%d.%03ds' $((ms / 1000)) $((ms % 1000))
  else
    printf '%dms' "$ms"
  fi
}

perf_log() {
  if [ "$PERF_LOG" = "0" ]; then
    return
  fi
  echo "[perf] $*" >&2
}

contains_word() {
  local needle="$1"
  shift
  local item
  for item in "$@"; do
    if [ "$item" = "$needle" ]; then
      return 0
    fi
  done
  return 1
}

split_csv_or_lines() {
  local value="$1"
  printf '%s\n' "$value" | tr ',' '\n' | sed '/^[[:space:]]*$/d'
}

hash_short() {
  local value="$1"
  if command -v sha256sum >/dev/null 2>&1; then
    printf '%s' "$value" | sha256sum | awk '{print substr($1,1,16)}'
  elif command -v sha1sum >/dev/null 2>&1; then
    printf '%s' "$value" | sha1sum | awk '{print substr($1,1,16)}'
  elif command -v shasum >/dev/null 2>&1; then
    printf '%s' "$value" | shasum -a 256 | awk '{print substr($1,1,16)}'
  else
    printf '%s' "$value" | tr -cd 'a-zA-Z0-9' | head -c 16
  fi
}

nix_cmd() {
  env -u NIX_CONFIG nix --extra-experimental-features "$NIX_FEATURES" "$@"
}

AGENT_BIN_DIR="$(CDPATH= cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$AGENT_BIN_DIR/lib/cli.sh"
. "$AGENT_BIN_DIR/lib/project_contract.sh"
. "$AGENT_BIN_DIR/lib/rootfs.sh"
. "$AGENT_BIN_DIR/lib/nix_roots.sh"
. "$AGENT_BIN_DIR/lib/runtime_lease.sh"
. "$AGENT_BIN_DIR/lib/artifact_prep.sh"
. "$AGENT_BIN_DIR/lib/container_api.sh"
. "$AGENT_BIN_DIR/lib/need_helper.sh"
. "$AGENT_BIN_DIR/lib/container_runtime.sh"
. "$AGENT_BIN_DIR/lib/dev_env.sh"
. "$AGENT_BIN_DIR/lib/environment.sh"
. "$AGENT_BIN_DIR/lib/doctor.sh"
. "$AGENT_BIN_DIR/lib/init.sh"
. "$AGENT_BIN_DIR/lib/login.sh"
. "$AGENT_BIN_DIR/lib/sessions.sh"
. "$AGENT_BIN_DIR/lib/viewer.sh"
. "$AGENT_BIN_DIR/lib/remote.sh"

TOOL=""
REMAINING_ARGS=()
AGENT_COMMAND="run"
if [ "$(basename "$0")" = "agent" ]; then
  case "${1:-}" in
    doctor)
      AGENT_COMMAND="doctor"
      shift
      REMAINING_ARGS=("$@")
      ;;
    init)
      AGENT_COMMAND="init"
      shift
      REMAINING_ARGS=("$@")
      ;;
    login)
      AGENT_COMMAND="login"
      shift
      REMAINING_ARGS=("$@")
      ;;
    sessions)
      AGENT_COMMAND="sessions"
      shift
      REMAINING_ARGS=("$@")
      ;;
    viewer)
      AGENT_COMMAND="viewer"
      shift
      REMAINING_ARGS=("$@")
      ;;
    remote)
      AGENT_COMMAND="remote"
      shift
      REMAINING_ARGS=("$@")
      ;;
    help|--help)
      print_help_and_exit
      ;;
    *)
      resolve_tool "$@"
      ;;
  esac
else
  resolve_tool "$@"
fi
RUN_START_MS="$(now_ms)"

if [ -z "$TOOL" ] && [ "${1:-}" = "--version" ]; then
  print_version_and_exit
fi

if [ "$AGENT_COMMAND" = "doctor" ]; then
  resolve_doctor_args "${REMAINING_ARGS[@]}"
  print_doctor_and_exit
fi

if [ "$AGENT_COMMAND" = "init" ]; then
  resolve_init_args "${REMAINING_ARGS[@]}"
  print_init_and_exit
fi

if [ "$AGENT_COMMAND" = "sessions" ]; then
  resolve_sessions_args "${REMAINING_ARGS[@]}"
  print_sessions_and_exit
fi

if [ "$AGENT_COMMAND" = "viewer" ]; then
  resolve_viewer_args "${REMAINING_ARGS[@]}"
  run_viewer_and_exit
fi

if [ "$AGENT_COMMAND" = "remote" ]; then
  resolve_remote_args "${REMAINING_ARGS[@]}"
fi

if [ "$AGENT_COMMAND" = "login" ]; then
  resolve_login_args "${REMAINING_ARGS[@]}"
elif [ "$AGENT_COMMAND" != "remote" ]; then
  validate_tool_access
fi

TMP_DIR=""
HELPER_STATE_DIR=""
LOGIN_STATE_DIR=""
PATH_GUARD_HOST_DIR=""
RUNTIME_IDENTITY_HOST_DIR=""
CODEX_AUTH_PLACEHOLDER=""
cleanup() {
  cleanup_runtime_lease
  if [ -n "$PATH_GUARD_HOST_DIR" ] && [ -d "$PATH_GUARD_HOST_DIR" ]; then
    rm -rf "$PATH_GUARD_HOST_DIR"
  fi
  if [ -n "$RUNTIME_IDENTITY_HOST_DIR" ] && [ -d "$RUNTIME_IDENTITY_HOST_DIR" ]; then
    rm -rf "$RUNTIME_IDENTITY_HOST_DIR"
  fi
  if [ -n "$CODEX_AUTH_PLACEHOLDER" ] && [ -f "$CODEX_AUTH_PLACEHOLDER" ] && [ ! -s "$CODEX_AUTH_PLACEHOLDER" ]; then
    rm -f "$CODEX_AUTH_PLACEHOLDER"
  fi
  if [ -n "$TMP_DIR" ] && [ -d "$TMP_DIR" ]; then
    rm -rf "$TMP_DIR"
  fi
  if [ -n "$HELPER_STATE_DIR" ] && [ -d "$HELPER_STATE_DIR" ]; then
    rm -rf "$HELPER_STATE_DIR"
  fi
  if [ -n "$LOGIN_STATE_DIR" ] && [ -d "$LOGIN_STATE_DIR" ]; then
    rm -rf "$LOGIN_STATE_DIR"
  fi
}
trap cleanup EXIT

if [ "$AGENT_COMMAND" = "remote" ]; then
  run_remote_and_exit
fi

bootstrap_environment
if [ "$AGENT_COMMAND" = "login" ]; then
  prepare_login_state
fi
prepare_runtime_lease
prepare_runtime_artifacts
prepare_container_api
prepare_need_helper
log_debug_context

build_container_args
if [ "$MODE" = "podman-rootfs" ]; then
  bind_runtime_lease_to_container "$RUNTIME" "$(current_sandbox_profile)" "$CONTAINER_NAME"
  prepare_runtime_lease_guard
fi

if [ "${AGENT_DEBUG:-0}" = "1" ]; then
  log_container_run_args
fi

set +e
run_container_runtime
status=$?
if [ "$MODE" = "podman-rootfs" ] && [ "$status" -ne 0 ]; then
  echo "[agent] podman --rootfs run failed." >&2
fi
set -e

if [ "$AGENT_COMMAND" = "login" ]; then
  finalize_login "$status"
fi

exit "$status"
