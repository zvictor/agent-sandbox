#!/usr/bin/env bash
set -euo pipefail

AGENT_BIN_DIR="$(CDPATH= cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$AGENT_BIN_DIR/lib/nix_roots.sh"
. "$AGENT_BIN_DIR/lib/runtime_lease.sh"

usage() {
  echo "usage: agent-nix-helper <materialize|serve> ..." >&2
  exit 1
}

resolve_host_home() {
  local host_home="${AGENT_HOST_HOME:-$HOME}"

  if [ "$host_home" = "/cache" ] || [ ! -d "$host_home" ]; then
    if command -v getent >/dev/null 2>&1; then
      host_home="$(getent passwd "$(id -u)" | cut -d: -f6)"
    elif [ -r /etc/passwd ]; then
      host_home="$(awk -F: -v uid="$(id -u)" '$3 == uid { print $6; exit }' /etc/passwd)"
    fi
  fi

  if [ -z "$host_home" ] || [ ! -d "$host_home" ]; then
    host_home="$PWD"
  fi

  printf '%s\n' "$host_home"
}

normalize_xdg_dir() {
  local current="$1"
  local fallback="$2"

  case "$current" in
    ""|"/cache"|"/cache/"|"/cache/"*)
      printf '%s\n' "$fallback"
      ;;
    *)
      printf '%s\n' "$current"
      ;;
  esac
}

normalize_tmpdir() {
  local current="${TMPDIR:-}"
  local fallback="$1"

  case "$current" in
    ""|"/tmp"|"/tmp/"|"/tmp/"*)
      printf '%s\n' "$fallback"
      ;;
    *)
      printf '%s\n' "$current"
      ;;
  esac
}

prepare_host_env() {
  local host_home

  host_home="$(resolve_host_home)"
  export HOME="$host_home"
  export XDG_CONFIG_HOME="$(normalize_xdg_dir "${XDG_CONFIG_HOME:-}" "$HOME/.config")"
  export XDG_DATA_HOME="$(normalize_xdg_dir "${XDG_DATA_HOME:-}" "$HOME/.local/share")"
  export XDG_CACHE_HOME="$(normalize_xdg_dir "${XDG_CACHE_HOME:-}" "$HOME/.cache")"
  export TMPDIR="$(normalize_tmpdir "${XDG_CACHE_HOME}/agent-sandbox/tmp")"

  mkdir -p "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME" "$TMPDIR"
}

validate_installable() {
  local installable="$1"

  if printf '%s\n' "$installable" | grep -Eq '^nixpkgs#[A-Za-z0-9._+-]+$'; then
    return 0
  fi

  if printf '%s\n' "$installable" | grep -Eq '^github:NixOS/nixpkgs/[^[:space:]#]+#[A-Za-z0-9._+-]+$'; then
    return 0
  fi

  echo "[agent] nix helper rejected installable '$installable'" >&2
  return 1
}

remove_materialization_roots() {
  local root_base="$1"
  local candidate=""

  rm -f -- "$root_base"
  for candidate in "$root_base"-*; do
    [ -L "$candidate" ] || continue
    rm -f -- "$candidate"
  done
}

verify_materialization_roots() {
  local root_base="$1"
  shift
  local output_path=""
  local candidate=""
  local rooted_path=""
  local found="0"

  for output_path in "$@"; do
    found="0"
    for candidate in "$root_base" "$root_base"-*; do
      [ -L "$candidate" ] || continue
      rooted_path="$(readlink -f "$candidate" 2>/dev/null || true)"
      if [ "$rooted_path" = "$output_path" ]; then
        found="1"
        break
      fi
    done
    if [ "$found" != "1" ]; then
      echo "Nix did not create a permanent root for output: $output_path" >&2
      return 1
    fi
  done
}

write_materialization_receipt() {
  local target="$1"
  local lease_id="$2"
  local installable="$3"
  local selected_out_path="$4"
  local bin_path="$5"
  shift 5
  local closure_file=""
  local outputs_file=""
  local pending=""

  closure_file="$(mktemp "$(dirname "$target")/.closure.XXXXXX")"
  outputs_file="$(mktemp "$(dirname "$target")/.outputs.XXXXXX")"
  pending="$(mktemp "$(dirname "$target")/.receipt.XXXXXX")"
  printf '%s\n' "$@" > "$outputs_file"

  if ! runtime_lease_path_info "$closure_file" "$@"; then
    rm -f "$closure_file" "$outputs_file" "$pending"
    return 1
  fi

  if ! jq -n \
    --arg lease_id "$lease_id" \
    --arg installable "$installable" \
    --arg selected_out_path "$selected_out_path" \
    --arg bin_path "$bin_path" \
    --rawfile outputs "$outputs_file" \
    --slurpfile closure "$closure_file" \
    '{
      schema_version: 1,
      lease_id: $lease_id,
      kind: "need-materialization",
      installable: $installable,
      output_paths: ($outputs | split("\n") | map(select(length > 0))),
      selected_out_path: $selected_out_path,
      bin_path: (if $bin_path == "" then null else $bin_path end),
      closure: ($closure[0] | to_entries | map({
        path: .key,
        narHash: .value.narHash,
        narSize: .value.narSize,
        references: (.value.references // [])
      }) | sort_by(.path))
    }' > "$pending"; then
    rm -f "$closure_file" "$outputs_file" "$pending"
    echo "could not write materialization receipt" >&2
    return 1
  fi

  rm -f "$closure_file" "$outputs_file"
  chmod 0444 "$pending"
  mv -f "$pending" "$target"
}

materialize_installable() {
  local installable="$1"
  local root_base="$2"
  local receipt_file="$3"
  local receipt_path="$4"
  local lease_id="$5"
  local out_path=""
  local bin_path=""
  local candidate_path=""
  local nix_features="${AGENT_NIX_EXPERIMENTAL_FEATURES:-nix-command flakes}"
  local -a out_paths=()

  validate_installable "$installable" || return 1
  prepare_host_env

  mapfile -t out_paths < <(
    env -u NIX_CONFIG nix --extra-experimental-features "$nix_features" build \
      --out-link "$root_base" --print-out-paths "$installable"
  ) || {
    remove_materialization_roots "$root_base"
    return 1
  }
  if [ "${#out_paths[@]}" -eq 0 ]; then
    remove_materialization_roots "$root_base"
    return 1
  fi

  for candidate_path in "${out_paths[@]}"; do
    case "$candidate_path" in
      /nix/store/*) ;;
      *)
        echo "Nix returned a non-store output: $candidate_path" >&2
        remove_materialization_roots "$root_base"
        return 1
        ;;
    esac
  done
  if ! verify_materialization_roots "$root_base" "${out_paths[@]}"; then
    remove_materialization_roots "$root_base"
    return 1
  fi

  out_path="${out_paths[0]}"
  for candidate_path in "${out_paths[@]}"; do
    if [ -d "$candidate_path/bin" ]; then
      bin_path="$candidate_path/bin"
      out_path="$candidate_path"
      break
    fi
  done

  if ! write_materialization_receipt \
    "$receipt_file" "$lease_id" "$installable" "$out_path" "$bin_path" "${out_paths[@]}"; then
    remove_materialization_roots "$root_base"
    return 1
  fi

  printf 'status=ok\n'
  printf 'installable=%s\n' "$installable"
  printf 'out_path=%s\n' "$out_path"
  printf 'bin_path=%s\n' "$bin_path"
  printf 'lease_id=%s\n' "$lease_id"
  printf 'receipt_path=%s\n' "$receipt_path"
}

write_error_response() {
  local target="$1"
  local installable="$2"
  local message="$3"
  local tmp

  tmp="$(mktemp "${target}.tmp.XXXXXX")"
  {
    printf 'status=error\n'
    printf 'installable=%s\n' "$installable"
    printf 'message=%s\n' "$message"
  } > "$tmp"
  mv -f "$tmp" "$target"
}

write_ok_response() {
  local target="$1"
  local source="$2"
  local tmp

  tmp="$(mktemp "${target}.tmp.XXXXXX")"
  cat "$source" > "$tmp"
  mv -f "$tmp" "$target"
}

serve_bridge() {
  local bridge_dir="$1"
  local ttl="${2:-900}"
  local lease_id="$3"
  local roots_dir="$4"
  local receipts_dir="$5"
  local requests_dir="$bridge_dir/requests"
  local processing_dir="$bridge_dir/processing"
  local responses_dir="$bridge_dir/responses"
  local heartbeat_file="$bridge_dir/heartbeat"
  local request_file=""
  local processing_file=""
  local response_file=""
  local result_file=""
  local command=""
  local installable=""
  local now=0
  local last_activity
  local last_heartbeat=0
  local stderr_file=""
  local task_pid=""
  local request_key=""
  local root_base=""
  local receipt_name=""
  local receipt_file=""
  local receipt_path=""
  declare -A bg_tasks=()

  shutdown_bridge() {
    local child_pid=""
    trap - TERM INT HUP
    echo "[helper] received signal, exiting" >&2
    for child_pid in "${!bg_tasks[@]}"; do
      kill "$child_pid" 2>/dev/null || true
    done
    for child_pid in "${!bg_tasks[@]}"; do
      wait "$child_pid" 2>/dev/null || true
    done
    rm -f "$heartbeat_file"
    exit 0
  }

  trap shutdown_bridge TERM INT HUP
  trap 'echo "[helper] error at line $LINENO (exit $?)" >&2' ERR

  mkdir -p "$requests_dir" "$processing_dir" "$responses_dir"

  # Clean up stale request/response files from a previous dead helper
  rm -f "$requests_dir"/*.req "$processing_dir"/*.req "$processing_dir"/result.* "$processing_dir"/stderr.* 2>/dev/null || true

  echo "[helper] started (pid=$$, ttl=${ttl}s, bridge=$bridge_dir)" >&2
  last_activity="$(date +%s)"

  while :; do
    # Write heartbeat every 30 seconds
    now="$(date +%s)"
    if [ $((now - last_heartbeat)) -ge 30 ]; then
      printf '%s\n' "$now" > "$heartbeat_file.tmp"
      mv -f "$heartbeat_file.tmp" "$heartbeat_file"
      last_heartbeat="$now"
    fi

    request_file=""
    for request_file in "$requests_dir"/*.req; do
      [ -f "$request_file" ] || continue

      processing_file="$processing_dir/$(basename "$request_file")"
      if ! mv "$request_file" "$processing_file" 2>/dev/null; then
        continue
      fi

      command=""
      installable=""
      while IFS='=' read -r key value; do
        case "$key" in
          command) command="$value" ;;
          installable) installable="$value" ;;
        esac
      done < "$processing_file"

      response_file="$responses_dir/$(basename "${processing_file%.req}").resp"
      result_file="$processing_dir/result.$RANDOM.$$"
      stderr_file="$processing_dir/stderr.$RANDOM.$$"
      request_key="$(printf '%s' "$(basename "$processing_file")" | sha256sum | awk '{print $1}')"
      root_base="$roots_dir/need-$request_key"
      receipt_name="need-$request_key.json"
      receipt_file="$receipts_dir/$receipt_name"
      receipt_path="/run/agent-runtime-receipts/$receipt_name"

      case "$command" in
        materialize)
          (
            set +e
            if materialize_installable \
              "$installable" "$root_base" "$receipt_file" "$receipt_path" "$lease_id" \
              >"$result_file" 2>"$stderr_file"; then
              write_ok_response "$response_file" "$result_file"
            else
              write_error_response "$response_file" "$installable" "$(tr '\n' ' ' < "$stderr_file" | sed 's/[[:space:]]\+/ /g; s/^ //; s/ $//')"
            fi
            rm -f "$processing_file" "$result_file" "$stderr_file"
          ) &
          bg_tasks["$!"]="$processing_file"
          ;;
        *)
          write_error_response "$response_file" "$installable" "unsupported command '$command'"
          rm -f "$processing_file"
          ;;
      esac

      last_activity="$(date +%s)"
    done

    for task_pid in "${!bg_tasks[@]}"; do
      if ! kill -0 "$task_pid" 2>/dev/null; then
        unset 'bg_tasks["$task_pid"]'
      fi
    done

    if [ "${#bg_tasks[@]}" -gt 0 ]; then
      last_activity="$(date +%s)"
    fi

    now="$(date +%s)"
    if [ "$ttl" -gt 0 ] && [ $((now - last_activity)) -ge "$ttl" ]; then
      for task_pid in "${!bg_tasks[@]}"; do
        wait "$task_pid" 2>/dev/null || true
      done
      rm -f "$heartbeat_file"
      exit 0
    fi

    sleep 1
  done
}

if [ "$#" -lt 1 ]; then
  usage
fi

COMMAND="$1"
shift

case "$COMMAND" in
  materialize)
    [ "$#" -eq 5 ] || usage
    materialize_installable "$1" "$2" "$3" "$4" "$5"
    ;;
  serve)
    [ "$#" -eq 5 ] || usage
    serve_bridge "$1" "$2" "$3" "$4" "$5"
    ;;
  *)
    usage
    ;;
esac
