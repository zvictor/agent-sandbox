#!/usr/bin/env python3
"""Lease-scoped GitHub App installation token broker.

Only a Unix socket is exposed to the sandbox. The App private key stays on the
host. Callers receive short-lived installation tokens, never the signing key.
"""
import base64
import datetime as dt
import hashlib
import json
import os
import re
import socketserver
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from http.server import BaseHTTPRequestHandler
from pathlib import Path


API_ROOT = "https://api.github.com"
API_VERSION = "2022-11-28"
REFRESH_MARGIN_SECONDS = 120
BROKER_PROTOCOL_VERSION = 2


def b64url(payload):
    return base64.urlsafe_b64encode(payload).rstrip(b"=").decode("ascii")


def app_jwt(app_id, key_file, now=None):
    now = int(time.time() if now is None else now)
    header = b64url(b'{"alg":"RS256","typ":"JWT"}')
    claims = b64url(json.dumps(
        {"iat": now - 60, "exp": now + 540, "iss": str(app_id)},
        separators=(",", ":"),
    ).encode())
    message = (header + "." + claims).encode("ascii")
    signature = subprocess.run(
        ["openssl", "dgst", "-sha256", "-sign", str(key_file)],
        input=message,
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    ).stdout
    return message.decode("ascii") + "." + b64url(signature)


class TokenIssuer:
    def __init__(self, app_id, installation_id, key_file, repositories=None, api_root=API_ROOT):
        self.app_id = app_id
        self.installation_id = installation_id
        self.key_file = key_file
        self.repositories = repositories or []
        self.api_root = api_root.rstrip("/")
        self.lock = threading.Lock()
        self.cached_token = None
        self.expires_at = 0

    def request_json(self, path, bearer, data=None):
        request = urllib.request.Request(
            self.api_root + path,
            data=None if data is None else json.dumps(data).encode(),
            method="GET" if data is None else "POST",
            headers={
                "Authorization": "Bearer " + bearer,
                "Accept": "application/vnd.github+json",
                "Content-Type": "application/json",
                "X-GitHub-Api-Version": API_VERSION,
                "User-Agent": "agent-sandbox-github-app-broker",
            },
        )
        with urllib.request.urlopen(request, timeout=20) as response:
            return json.load(response)

    def get_identity(self):
        app = self.request_json("/app", app_jwt(self.app_id, self.key_file))
        slug = app.get("slug")
        if not isinstance(slug, str) or not re.fullmatch(r"[A-Za-z0-9-]+", slug):
            raise ValueError("GitHub returned an invalid App slug")
        login = slug + "[bot]"
        user = self.request_json(
            "/users/" + urllib.parse.quote(login, safe=""), self.get_token()
        )
        user_id = user.get("id")
        if user.get("login") != login or user.get("type") != "Bot" \
                or type(user_id) is not int or user_id <= 0:
            raise ValueError("GitHub returned an invalid App bot identity")
        return login, str(user_id) + "+" + login + "@users.noreply.github.com"

    def get_token(self):
        with self.lock:
            if self.cached_token and time.time() < self.expires_at - REFRESH_MARGIN_SECONDS:
                return self.cached_token
            jwt = app_jwt(self.app_id, self.key_file)
            data = {}
            if self.repositories:
                data["repositories"] = self.repositories
            result = self.request_json(
                "/app/installations/" + str(self.installation_id) + "/access_tokens", jwt, data
            )
            token = result["token"]
            expires = dt.datetime.fromisoformat(result["expires_at"].replace("Z", "+00:00"))
            expiry = expires.timestamp()
            if not isinstance(token, str) or not token or expiry <= time.time() + 10:
                raise ValueError("GitHub returned an unusable installation token")
            self.cached_token, self.expires_at = token, expiry
            return token


def parse_installation_ids(value):
    if not re.fullmatch(r"[0-9]+(?:,[0-9]+)*", value):
        raise ValueError("installation IDs must be comma-separated numbers")
    ids = [str(int(item)) for item in value.split(",")]
    if "0" in ids or len(set(ids)) != len(ids):
        raise ValueError("installation IDs must be positive and unique")
    return ids


def configuration_fingerprint(app_id, installation_ids, key_file, repositories=None):
    config = [BROKER_PROTOCOL_VERSION, app_id, installation_ids, str(Path(key_file).resolve()), repositories or []]
    return hashlib.sha256(json.dumps(config, separators=(",", ":")).encode()).hexdigest()


class RepositoryContextError(ValueError):
    pass


class RepositoryAccessError(PermissionError):
    pass


class TokenRouter:
    def __init__(self, app_id, installation_ids, key_file, repositories=None, api_root=API_ROOT):
        self.issuers = {
            item: TokenIssuer(app_id, item, key_file, api_root=api_root)
            for item in installation_ids
        }
        if not self.issuers:
            raise ValueError("at least one installation ID is required")
        self.repositories = repositories or []
        for repo in self.repositories:
            qualified = re.fullmatch(r"[A-Za-z0-9-]+/[A-Za-z0-9_.-]+", repo)
            bare = len(self.issuers) == 1 and re.fullmatch(r"[A-Za-z0-9_.-]+", repo)
            if not (qualified or bare):
                raise ValueError("repository scope must use OWNER/REPO with multiple installations")
        self.owners = {}
        self.lock = threading.Lock()

    def load_installations(self):
        with self.lock:
            if self.owners:
                return
            owners = {}
            for installation_id, issuer in self.issuers.items():
                metadata = issuer.request_json(
                    "/app/installations/" + installation_id,
                    app_jwt(issuer.app_id, issuer.key_file),
                )
                owner = metadata.get("account", {}).get("login", "")
                if metadata.get("id") != int(installation_id) or not isinstance(owner, str) \
                        or not re.fullmatch(r"[A-Za-z0-9-]+", owner):
                    raise ValueError("GitHub returned invalid installation metadata")
                owner = owner.lower()
                if owner in owners:
                    raise ValueError("multiple configured installations have the same owner")
                names = [repo.split("/")[-1] for repo in self.repositories
                         if "/" not in repo or repo.split("/")[0].lower() == owner]
                if self.repositories and not names:
                    raise ValueError("repository scope must include a repository for each installation")
                issuer.repositories = names
                owners[owner] = issuer
            self.owners = owners

    def get_identity(self):
        self.load_installations()
        return next(iter(self.issuers.values())).get_identity()

    def get_token(self, repository=None):
        if repository:
            if not re.fullmatch(r"[A-Za-z0-9-]+/[A-Za-z0-9_.-]+", repository):
                raise RepositoryContextError("repository must be OWNER/REPO")
            owner, name = repository.split("/")
            if self.repositories and not any(
                item.lower() in (repository.lower(), name.lower()) for item in self.repositories
            ):
                raise RepositoryAccessError("repository is outside the configured allowlist")
            self.load_installations()
            issuer = self.owners.get(owner.lower())
            if issuer is None:
                raise RepositoryAccessError("no configured GitHub App installation for repository owner")
        elif len(self.issuers) == 1:
            self.load_installations()
            issuer = next(iter(self.issuers.values()))
        else:
            raise RepositoryContextError("multiple installations require repository context; use GH_REPO or --repo")
        return issuer.get_token()


class TokenHandler(BaseHTTPRequestHandler):
    issuer = None
    health_response = "ok\n"

    def log_message(self, fmt, *args):
        # Never log request bodies, installation tokens, or signing material.
        return

    def send_text(self, code, body):
        payload = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def do_GET(self):
        target = urllib.parse.urlsplit(self.path)
        if target.path == "/health" and not target.query:
            self.send_text(200, self.health_response)
        elif target.path == "/token":
            try:
                query = urllib.parse.parse_qs(target.query, keep_blank_values=True)
                if query and (set(query) != {"repository"} or len(query["repository"]) != 1 or not query["repository"][0]):
                    raise RepositoryContextError("expected a single repository=OWNER/REPO parameter")
                repository = query.get("repository", [None])[0]
                self.send_text(200, self.issuer.get_token(repository) + "\n")
            except RepositoryAccessError as exc:
                self.send_text(403, str(exc) + "\n")
            except RepositoryContextError as exc:
                self.send_text(400, str(exc) + "\n")
            except Exception as exc:
                # Error details belong in the trusted host log, not the sandbox.
                print("GitHub App token refresh failed: " + type(exc).__name__, file=sys.stderr)
                self.send_text(503, "GitHub App authentication unavailable\n")
        else:
            self.send_text(404, "not found\n")

    def do_POST(self):
        self.send_text(405, "method not allowed\n")


class Broker(socketserver.ThreadingUnixStreamServer):
    daemon_threads = True
    allow_reuse_address = False


def serve(socket_path, app_id, installation_ids, key_file, repositories=None):
    if not app_id.isdecimal():
        raise ValueError("GitHub App ID must be numeric")
    key = Path(key_file).resolve(strict=True)
    if not key.is_file():
        raise ValueError("GitHub App private key must be a regular file")
    parent = Path(socket_path).parent
    if parent.is_symlink() or not parent.is_dir():
        raise ValueError("socket parent must be a real directory")
    if os.path.lexists(socket_path):
        raise ValueError("refusing to overwrite an existing socket path")
    handler = type("ConfiguredTokenHandler", (TokenHandler,), {
        "issuer": TokenRouter(app_id, installation_ids, key, repositories),
        "health_response": "ok " + configuration_fingerprint(app_id, installation_ids, key, repositories) + "\n",
    })
    server = Broker(socket_path, handler)
    try:
        os.chmod(socket_path, 0o600)
        server.serve_forever(poll_interval=0.2)
    finally:
        server.server_close()
        try:
            os.unlink(socket_path)
        except FileNotFoundError:
            pass


def main(argv):
    if len(argv) not in (5, 6):
        raise SystemExit(
            "usage: agent-github-app-broker SOCKET|--identity|--fingerprint APP_ID INSTALLATION_IDS PRIVATE_KEY_FILE [REPO1,REPO2]"
        )
    socket_path, app_id, installation_spec, key_file = argv[1:5]
    installation_ids = parse_installation_ids(installation_spec)
    repositories = argv[5].split(",") if len(argv) == 6 and argv[5] else []
    if socket_path == "--fingerprint":
        TokenRouter(app_id, installation_ids, key_file, repositories)
        print(configuration_fingerprint(app_id, installation_ids, key_file, repositories))
    elif socket_path == "--identity":
        login, email = TokenRouter(app_id, installation_ids, key_file, repositories).get_identity()
        print(login)
        print(email)
    else:
        serve(socket_path, app_id, installation_ids, key_file, repositories)


if __name__ == "__main__":
    main(sys.argv)
